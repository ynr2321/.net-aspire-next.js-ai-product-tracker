{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "CostMonitoring": {
    "PollingIntervalSeconds": 60,
    "SubscriptionId": "",
    "SubscriptionName": "Azure subscription 1",
    "ResourceGroup": "rg-aspire-ai-product-tracker",
    "Resources": {
      "FrontendContainerApp": "frontend",
      "BackendContainerApp": "apiservice",
      "PostgresFlexibleServer": "postgresserver-wcfqosgiu5c3o"
    },
    "Rules": [
      {
        "Name": "FrontendRequestCap",
        "Enabled": true,
        "Metric": "Requests",
        "WindowMinutes": 10,
        "Threshold": 100000,
        "MonitoredResources": [ "Frontend" ],
        "ShutdownTargets": [ "Frontend", "Backend" ]
      },
      {
        "Name": "BackendRequestCap",
        "Enabled": true,
        "Metric": "Requests",
        "WindowMinutes": 10,
        "Threshold": 100000,
        "MonitoredResources": [ "Backend" ],
        "ShutdownTargets": [ "Frontend", "Backend", "Database" ]
      }
    ]
  }
}
